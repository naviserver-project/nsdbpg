# Run on a dedicated PostgreSQL database; tables below are connection-local.
proc pgValue {sql args} {
    set row [uplevel 1 [list ns_db 1row $::bindHandle {*}$args -- $sql]]
    try {
        return [ns_set array $row]
    } finally {
        ns_set free $row
    }
}

test pg-bind-capabilities {core discovers optional bind callbacks} -body {
    list [ns_db bindinfo $bindHandle] [ns_db bindinfo $bindHandle -version]
} -result {1 6}

test pg-bind-vars {text is sent separately with quotes, Unicode and SQL-looking contents intact} -body {
    set value {café '); DROP TABLE bind_items; -- :ignored $literal}
    dict get [pgValue {SELECT :value::text AS v} -bindvars] v
} -result {café '); DROP TABLE bind_items; -- :ignored $literal}

test pg-bind-sources {dict and ns_set sources do not use caller-variable values} -body {
    set v caller
    set bindings [ns_set create bindings v set-value]
    try {
        list [dict get [pgValue {SELECT :v::text AS v} -binddict {v dict-value}] v] \
            [dict get [pgValue {SELECT :v::text AS v} -bindset $bindings] v]
    } finally {
        ns_set free $bindings
    }
} -result {dict-value set-value}

test pg-bind-missing {missing values are rejected for every source even with emptynull} -body {
    unset -nocomplain absent
    set bindings [ns_set create]
    try {
        list [catch {pgValue {SELECT :absent::text} -bindvars -emptynull}] \
            [catch {pgValue {SELECT :absent::text} -binddict {} -emptynull}] \
            [catch {pgValue {SELECT :absent::text} -bindset $bindings -emptynull}]
    } finally {
        ns_set free $bindings
    }
} -result {1 1 1}

test pg-bind-empty {scalar empty text and explicitly requested NULL are distinct} -body {
    set v {}
    list [pgValue {SELECT :v::text IS NULL AS n,length(:v::text) AS len} -bindvars] \
        [pgValue {SELECT :v::text IS NULL AS n} -bindvars -emptynull]
} -result {{n f len 0} {n t}}

test pg-bind-repeated {repeated names share one positional parameter} -body {
    set v 7
    pgValue {SELECT :v::integer+:v::integer AS n} -bindvars
} -result {n 14}

test pg-bind-comments {supported comments, strings and casts do not introduce bindings} -body {
    set v 3
    pgValue {SELECT :v::integer AS n, ':not_bind'::text AS s /* :ignored */ -- :ignored2
    } -bindvars
} -result {n 3 s :not_bind}

test pg-bind-legacy-name {dollar and hash continuation characters retain legacy bind names} -body {
    pgValue {SELECT :v$part::text AS a,:v#part::text AS b} -binddict {v$part one v#part two}
} -result {a one b two}

test pg-bind-list {list expansion remains parameterized and shape changes invalidate cached SQL} -body {
    set statement {SELECT count(*) AS n FROM (VALUES(1),(2),(3)) t(id) WHERE id IN (:ids)}
    set ids {1 3}
    set first [dict get [pgValue $statement -bindvars -bindtypes {ids list}] n]
    set ids {2}
    list $first [dict get [pgValue $statement -bindvars -bindtypes {ids list}] n]
} -result {2 1}

test pg-bind-rows {rows of values preserve text, scalar conversion and NULL policy} -body {
    set rows {{1 one} {2 {}}}
    ns_db dml $bindHandle -bindvars -bindtypes {rows rows} -emptynull {
        INSERT INTO bind_items(id,v) VALUES :rows
    }
    pgValue {SELECT count(*) AS n,count(v) AS nonnull FROM bind_items WHERE id IN (1,2)} -binddict {}
} -result {n 2 nonnull 1}

test pg-bind-binary {binary scalar binding preserves NUL, high bytes and empty bytea} -body {
    set value [binary format H* 00ff8001]
    set empty [binary format H* {}]
    list [pgValue {SELECT encode(:value,'hex') AS hex,octet_length(:empty) AS len} \
        -bindvars -bindtypes {value binary empty binary}] \
        [pgValue {SELECT :empty IS NULL AS n} -bindvars -bindtypes {empty binary} -emptynull]
} -result {{hex 00ff8001 len 0} {n t}}

test pg-bind-binary-rows {typed row columns send bytea without hex interpolation} -body {
    set rows [list [list 11 [binary format H* 00ff] first] [list 12 [binary format H* {}] second]]
    ns_db dml $bindHandle -bindvars -bindtypes {rows {rows {scalar binary scalar}}} {
        INSERT INTO bind_items(id,b,v) VALUES :rows
    }
    pgValue {SELECT encode(b,'hex') AS hex,v FROM bind_items WHERE id=11} -binddict {}
} -result {hex 00ff v first}

test pg-bind-alias {one Tcl object can be interpreted as text and binary in the same call} -body {
    set value [binary format H* 636166c3a9]
    set values [dict create text $value bytes $value]
    pgValue {SELECT encode(:bytes,'hex') AS hex,length(:text::text)>0 AS present} \
        -binddict $values -bindtypes {bytes binary}
} -result {hex 636166c3a9 present t}

test pg-bind-nul {embedded NUL in text fails before execution and later SQL still works} -body {
    set value "a\x00b"
    set failed [catch {pgValue {SELECT :value::text} -bindvars} message]
    list $failed [string match {*NUL*} $message] [pgValue {SELECT 1 AS n} -binddict {}]
} -result {1 1 {n 1}}

test pg-bind-cardinality {ordinary ns_db cardinality checks still apply} -body {
    list [catch {ns_db 1row $bindHandle -binddict {} {SELECT 1 WHERE false}}] \
        [ns_db 0or1row $bindHandle -binddict {} {SELECT 1 WHERE false}] \
        [catch {ns_db 0or1row $bindHandle -binddict {} {SELECT 1 UNION ALL SELECT 2}}]
} -result {1 {} 1}

test pg-bind-select {select bindrow getrow and flush retain the normal result lifecycle} -body {
    set v 1
    set row [ns_db select $bindHandle -bindvars {SELECT :v::integer AS n UNION ALL SELECT 2}]
    set first [ns_db getrow $bindHandle $row]
    set one [ns_set get $row n]
    set second [ns_db getrow $bindHandle $row]
    set two [ns_set get $row n]
    set done [ns_db getrow $bindHandle $row]
    list $first $one $second $two $done
} -result {1 1 1 2 0}

test pg-bind-exec {exec returns the usual row and DML classifications} -body {
    set v 15
    set result [ns_db exec $bindHandle -bindvars {SELECT :v::integer AS n}]
    set row [ns_db bindrow $bindHandle]
    ns_db getrow $bindHandle $row
    set n [ns_set get $row n]
    ns_db flush $bindHandle
    list $result $n [ns_db exec $bindHandle -bindvars {UPDATE bind_items SET v='changed' WHERE id=:v}] [ns_db rowcount $bindHandle]
} -result {NS_ROWS 15 NS_DML 0}

test pg-bind-error {server errors retain diagnostics and do not commit a caller transaction} -body {
    ns_db dml $bindHandle BEGIN
    set id 21
    ns_db dml $bindHandle -bindvars {INSERT INTO bind_items(id) VALUES(:id)}
    set failed [catch {ns_db dml $bindHandle -bindvars {INSERT INTO bind_items(id) VALUES(:id)}}]
    set diagnostic [string match {*duplicate key*} [ns_dberrormsg $bindHandle]]
    ns_db dml $bindHandle ROLLBACK
    list $failed $diagnostic [pgValue {SELECT count(*) AS n FROM bind_items WHERE id=21} -binddict {}]
} -result {1 1 {n 0}}

test pg-bind-single-statement {parameter execution rejects multiple statements without applying the first} -body {
    set id 22
    set failed [catch {ns_db dml $bindHandle -bindvars {INSERT INTO bind_items(id) VALUES(:id); INSERT INTO bind_items(id) VALUES(23)}}]
    list $failed [pgValue {SELECT count(*) AS n FROM bind_items WHERE id IN(22,23)} -binddict {}]
} -result {1 {n 0}}

test pg-bind-invalid-types {invalid collection shapes fail before SQL} -body {
    list [catch {pgValue {SELECT :ids} -binddict {ids {}} -bindtypes {ids list}}] \
        [catch {pgValue {VALUES :rows} -binddict {rows {{1 2} {3}}} -bindtypes {rows rows}}]
} -result {1 1}

test pg-bind-shared-sql {cached SQL objects work across legacy and core interfaces} -body {
    set statement {SELECT :v::text AS v}
    set v first
    set a [ns_pg_bind 1row $bindHandle $statement]
    set first [ns_set get $a v]
    ns_set free $a
    set v second
    set second [dict get [pgValue $statement -bindvars] v]
    set v third
    set a [ns_pg_bind 1row $bindHandle $statement]
    set third [ns_set get $a v]
    ns_set free $a
    list $first $second $third
} -result {first second third}

test pg-bind-legacy {legacy bind syntax and empty-to-NULL behavior remain unchanged} -body {
    set bindings [ns_set create bindings v {}]
    try {
        set row [ns_pg_bind 1row $bindHandle -bind $bindings {SELECT :v::text IS NULL AS n}]
        set n [ns_set get $row n]
        ns_set free $row
        set v value
        set row [ns_pg_bind 1row $bindHandle {SELECT :v::text AS v}]
        set v [ns_set get $row v]
        ns_set free $row
        list $n $v
    } finally {
        ns_set free $bindings
    }
} -result {t value}

test pg-bind-legacy-multi {ordinary legacy execution still accepts multiple statements} -body {
    ns_db dml $bindHandle {INSERT INTO bind_items(id) VALUES(31); INSERT INTO bind_items(id) VALUES(32)}
    set row [ns_pg_bind 1row $bindHandle {SELECT count(*) AS n FROM bind_items WHERE id IN(31,32)}]
    try {
        ns_set get $row n
    } finally {
        ns_set free $row
    }
} -result 2

test pg-bind-legacy-dml {legacy DML and streaming SELECT can be mixed with core binds} -body {
    set id 33
    ns_pg_bind dml $bindHandle {INSERT INTO bind_items(id) VALUES(:id)}
    set row [ns_pg_bind select $bindHandle {SELECT id FROM bind_items WHERE id=:id}]
    set got [ns_db getrow $bindHandle $row]
    set value [ns_set get $row id]
    ns_db flush $bindHandle
    list $got $value [pgValue {SELECT 34 AS n} -binddict {}]
} -result {1 33 {n 34}}

source [file join [file dirname [info script]] array.test]
rename pgValue {}
